rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function isNewOwner() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function onlyUpdatesStats() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes", "cevap"]);
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /discussions/{postId} {
      allow read: if true;
      allow create: if isNewOwner();
      allow update: if isOwner() || onlyUpdatesStats();
      allow delete: if isOwner();
    }

    match /discussion_replies/{replyId} {
      allow read: if true;
      allow create: if isNewOwner();
      allow update, delete: if isOwner();
    }

    match /public_pins/{pinId} {
      allow read: if true;
      allow create: if isNewOwner();
      allow update, delete: if isOwner();
    }

    match /place_reviews/{reviewId} {
      allow read: if true;
      allow create: if isNewOwner();
      allow update, delete: if isOwner();
    }

    match /routes/{routeId} {
      allow read: if true;
      allow create: if isNewOwner();
      allow update: if isOwner() || onlyUpdatesStats();
      allow delete: if isOwner();
    }

    match /contactMessages/{messageId} {
      allow create: if isNewOwner();
      allow read, update, delete: if false;
    }

    // Eski koleksiyon adlari: eski kod/veri kalirsa okumayi-yazmayi bozmasin.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isNewOwner();
      allow update, delete: if isOwner();
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isNewOwner();
      allow update: if isOwner() || onlyUpdatesStats();
      allow delete: if isOwner();
    }

    match /communityComments/{commentId} {
      allow read: if true;
      allow create: if isNewOwner();
      allow update, delete: if isOwner();
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if false;
    }

    match /places/{placeId} {
      allow read: if true;
      allow write: if false;
    }

    match /admins/{adminId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
